# Copy to .env for development. Placeholders only: never commit real values.
# The owner's real copy is .env.age, encrypted with age64 (`deno task env:encrypt`).

# The address people open the app at.
PUBLIC_URL=http://localhost:5173

# The CalDAV server and the one account the app uses. `deno task radicale:up` starts a local
# Radicale at http://localhost:5232 that accepts any username and password.
CALDAV_URL=http://localhost:5232
CALDAV_USERNAME=<your CalDAV username>
CALDAV_PASSWORD=<your CalDAV password>

# The owner's sign-in password, hashed: run `deno task password:hash`.
OWNER_PASSWORD_HASH=<output of deno task password:hash>

# Both at least 32 characters. Generate each with: openssl rand -base64 32
AUTH_PEPPER=<random, 32+ characters>
SESSION_SECRET=<random, 32+ characters>

# Reminder notifications (Web Push). Optional as a group: leave all five empty and the app runs
# without them; set only some and the server refuses to start.

# The VAPID key pair the server signs each push with. `deno task vapid:keys mailto:you@example.com`
# writes these three lines. The public key goes to the browser.
VAPID_PUBLIC_KEY=
# A secret. New keys end every device's subscription.
VAPID_PRIVATE_KEY=
# How a push service can reach you: a mailto: or https: address.
VAPID_SUBJECT=
# The folder of the one file the server writes: the push subscriptions. `data` in development (the
# only folder `deno task dev` may write), `/data` in the container.
DATA_DIR=
# The IANA zone for a reminder on a task with a date and no time, or a time with no zone, such as
# Europe/Berlin. A task due "on the 12th" reminds at 09:00 that day in this zone.
REMINDER_TIME_ZONE=
